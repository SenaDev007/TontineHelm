# ── TontiHelm Frontend (Vercel) — variables d'environnement ──
# Copie ce fichier en .env.local (dev) ou renseigne-les dans Vercel (production).

# URL publique de l'API déployée sur Railway.
# En production (Vercel) : NEXT_PUBLIC_API_URL=https://ton-service.up.railway.app
# En local via la passerelle sandbox : laisser vide (le port passe par XTransformPort).
NEXT_PUBLIC_API_URL=

# Port du backend en développement local (passerelle) — 3001 par défaut.
NEXT_PUBLIC_API_PORT=3001

// TontiHelm — schéma de données (cahier des charges §14.5)
// PostgreSQL (Neon) : les montants restent des entiers (le FCFA n'a pas de centimes),
// les payloads JSON sont stockés en texte, l'isolation multi-structure
// est appliquée au niveau applicatif (tenantId sur chaque table métier).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Structure {
  id             String   @id @default(cuid())
  name           String
  kind           String // 'sfd' | 'groupement' | 'pme'
  licenseRef     String? // numéro d'agrément / récépissé / RC — facultatif à l'inscription
  licenseDocName String?
  city           String?
  status         String   @default("pending") // pending | active | suspended | closed
  commissionDays Int      @default(1) // règle jours : valeur × mise journalière
  lateThreshold  Int      @default(3) // jours manqués avant statut « en retard »
  rejectionNote  String?
  // Lien dédié de l'entité : /e/{slug} — portail propre à chaque PME/particulier,
  // utilisé par ses agents, ses gérants et les liens de carnet de ses clients.
  slug           String?  @unique
  createdAt      DateTime @default(now())

  users         User[]
  contributors  Contributor[]
  passbooks     Passbook[]
  collections   Collection[]
  closings      Closing[]
  payments      Payment[]
  notifications Notification[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  invoices      Invoice[]
  planEvents    PlanEvent[]

  @@index([status])
}

model User {
  id          String    @id @default(cuid())
  tenantId    String?
  phone       String    @unique
  fullName    String
  role        String // 'owner' | 'manager' | 'agent' | 'controller' | 'admin'
  pinHash     String
  status      String    @default("active")
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  structure           Structure?           @relation(fields: [tenantId], references: [id])
  sessions            Session[]
  agentContributors   Contributor[]        @relation("AgentContributors")
  agentPassbooks      Passbook[]           @relation("AgentPassbooks")
  agentCollections    Collection[]         @relation("AgentCollections")
  agentClosings      Closing[]            @relation("AgentClosings")
  auditEntries        AuditLog[]           @relation("AuditActor")

  // ── Mobile natif (phase 1, PARITE.md §8.5/§8.7) — additive, le web garde ──
  // ses sessions 30 jours telles quelles : les appareils, le PIN Argon2id et ──
  // les jetons mobiles vivent dans des tables séparées. ──
  devices             Device[]
  mobileCredential    MobileCredential?

  @@index([tenantId, role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Contributor {
  id           String   @id @default(cuid())
  tenantId     String
  fullName     String
  phone        String?
  email        String? // pour l'envoi du lien du carnet par courriel
  neighborhood String?
  idNumber     String?
  agentId      String
  // Lien personnel du cotisant : consultation de son carnet sans compte
  // (partage WhatsApp / e-mail). Généré à la création ou à la première demande.
  shareToken   String?  @unique
  status       String   @default("active") // active | inactive
  createdAt    DateTime @default(now())
  // Traction incrémentale /v1/sync/pull (phase 1) : NULL = jamais modifié
  // depuis l'ajout de la colonne (l'état initial part du snapshot complet du
  // premier pull). Renseigné automatiquement à chaque écriture ultérieure.
  updatedAt    DateTime? @updatedAt

  structure Structure  @relation(fields: [tenantId], references: [id])
  agent     User       @relation("AgentContributors", fields: [agentId], references: [id])
  passbooks Passbook[]

  @@index([tenantId])
}

model Passbook {
  id            String    @id @default(cuid())
  tenantId      String
  contributorId String
  agentId       String
  number        String
  dailyAmount   Int
  cycleDays     Int
  startsOn      DateTime
  status        String    @default("active") // active | late | closed | withdrawn | closing | completed
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  // ── Livret annuel : surnom du carnet (un client peut prendre plusieurs carnets,
  // chacun dédié à un usage — « boutique », « école », etc.). ──
  label         String?

  // ── Fin de souscription : récapitulatif + signature numérique du client ──
  // Le gérant déclenche la remise ; le client certifie sur SON lien de carnet
  // qu'il a fini de cotiser et pris son argent ; le carnet est alors archivé.
  completedAt   DateTime?
  payoutAmount  Int? // montant remis au client
  companyAmount Int? // part de l'entreprise (31es mises)
  signatureName String? // nom saisi par le signataire
  signatureData String? // tracé de signature (PNG dataURL, léger)
  signedAt      DateTime?
  // Traction incrémentale /v1/sync/pull (phase 1) — même règle que Contributor.
  updatedAt     DateTime? @updatedAt

  contributor Contributor  @relation(fields: [contributorId], references: [id])
  agent       User         @relation("AgentPassbooks", fields: [agentId], references: [id])
  structure   Structure    @relation(fields: [tenantId], references: [id])
  collections Collection[]
  payments    Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([agentId])
  @@index([tenantId, status, completedAt])
}

model Collection {
  id          String   @id // UUID généré par l'application agent (idempotence)
  tenantId    String
  passbookId  String
  agentId     String
  amount      Int // positif ; négatif si écriture d'annulation
  method      String // 'cash' | 'mobile_money'
  dayIndex    Int // jour du cycle au moment de l'encaissement
  coversOn    DateTime? // journée calendaire réelle couverte par l'écriture (multi-jours)
  reversesId  String? // référence à l'encaissement annulé
  closingId   String?
  collectedAt DateTime // horodatage de la collecte sur le terrain
  receivedAt  DateTime @default(now()) // réception serveur

  passbook  Passbook @relation(fields: [passbookId], references: [id])
  agent     User     @relation("AgentCollections", fields: [agentId], references: [id])
  structure Structure @relation(fields: [tenantId], references: [id])

  @@index([tenantId, collectedAt])
  @@index([passbookId])
  @@index([passbookId, coversOn])
}

model Closing {
  id           String    @id @default(cuid())
  tenantId     String
  agentId      String
  day          DateTime
  declaredCash Int
  expectedCash Int
  gap          Int
  status       String    @default("open") // open | declared | validated | disputed
  validatedBy  String?
  validatedAt  DateTime?
  createdAt    DateTime  @default(now())

  agent     User       @relation("AgentClosings", fields: [agentId], references: [id])
  structure Structure  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, day])
}

model Payment {
  id            String    @id @default(cuid())
  tenantId      String
  passbookId    String
  contributorId String
  provider      String    @default("fedapay")
  providerRef   String?
  amount        Int
  status        String    @default("created") // created | pending | approved | declined | expired | canceled
  linkUrl       String?
  createdAt     DateTime  @default(now())
  settledAt     DateTime?

  passbook  Passbook @relation(fields: [passbookId], references: [id])
  structure Structure @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  channel   String // 'sms' | 'whatsapp'
  template  String // 'receipt' | 'late_reminder' | 'cycle_end'
  toPhone   String?
  content   String
  status    String   @default("sent") // queued | sent | failed
  costFcfa  Int      @default(0)
  createdAt DateTime @default(now())

  structure Structure @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

model AuditLog {
  seq      BigInt   @id @default(autoincrement()) // ordre déterministe de la chaîne (§14.5)
  tenantId String
  actorId  String?
  action   String // 'login' | 'collection' | 'reverse' | 'closing_declared' | 'closing_validated' | 'structure_approved' | ...
  entity   String
  entityId String?
  payload  String // JSON texte
  prevHash String?
  hash     String
  at       DateTime @default(now())

  actor     User?      @relation("AuditActor", fields: [actorId], references: [id])
  structure Structure  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, seq])
}

model DemoRequest {
  id           String   @id @default(cuid())
  fullName     String
  phone        String
  structure    String
  city         String?
  contributors Int? // taille approximative du portefeuille de cotisants
  agents       Int? // nombre approximatif d'agents de collecte
  message      String?
  status       String   @default("new") // new | contacted | converted | closed
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

model Subscription {
  id          String    @id @default(cuid())
  tenantId    String    @unique
  plan        String // 'demarrage' | 'pro' | 'institution'
  status      String // 'trial' | 'active' | 'past_due' | 'read_only' | 'canceled'
  trialEndsAt DateTime?
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())

  structure Structure @relation(fields: [tenantId], references: [id])
}

// ── Paiement d'inscription (self-service, patron Academia Helm) ──
// La structure et le compte dirigeant ne sont créés qu'APRÈS approbation du
// paiement : toutes les informations du formulaire vivent dans `draft` (JSON)
// jusqu'à confirmation par FedaPay. Le montant est calculé côté serveur.
model SignupPayment {
  id            String    @id @default(cuid())
  provider      String    @default("fedapay")
  providerRef   String? // identifiant de transaction FedaPay
  plan          String // 'demarrage' | 'pro' | 'institution'
  billingPeriod String    @default("monthly") // 'monthly' | 'yearly'
  amount        Int // FCFA, calculé serveur selon plan + période
  status        String    @default("pending") // pending | approved | declined | expired
  draft         String // JSON : structure + dirigeant + pinHash
  structureId   String? // renseigné à l'activation (idempotence)
  error         String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  @@index([status, createdAt])
}

model Invoice {
  id         String   @id @default(cuid())
  tenantId   String
  period     String // '2026-09'
  baseAmount Int
  extras     String // JSON texte : dépassements quota, SMS, agents supplémentaires
  total      Int
  status     String   @default("pending") // pending | paid
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  structure Structure @relation(fields: [tenantId], references: [id])

  @@index([tenantId, period])
}

// ── Alertes de palier aux dirigeants (montée en charge automatique) ──
// Le système surveille cotisants actifs, agents et volume encaissé : à l'approche
// des quotas il prévient (« tu vas scaler »), au dépassement il bascule le palier
// supérieur tout seul et en accuse réception aux dirigeants.
model PlanEvent {
  id           String   @id @default(cuid())
  tenantId     String
  kind         String // 'scaling_warning' | 'plan_upgraded' | 'device_clock_skew' (phase 1, §8.6)
  fromPlan     String?
  toPlan       String? // null hors contexte de palier (p. ex. device_clock_skew, phase 1)
  contributors Int      @default(0) // cotisants actifs au moment de l'événement
  agents       Int      @default(0)
  volumeMonth  Int      @default(0) // FCFA encaissés sur 30 jours glissants
  message      String
  readAt       DateTime?
  createdAt    DateTime @default(now())

  structure Structure @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

// ── Mobile natif Android (phase 1) — PARITE.md §8.5/§8.7. ──
// Tout est ADDITIF : aucune route /api/* ne lit ces tables ; l'authentification
// web (Session + PIN scrypt) reste inchangée et fonctionne en parallèle.

// Appareil enregistré par un membre du personnel. La révocation coupe les
// jetons et la synchronisation de CET appareil uniquement ; l'utilisateur
// lui-même ou le gérant liste et révoque (routes /v1/devices).
model Device {
  id           String    @id @default(cuid())
  userId       String
  label        String // nom saisi à l'enregistrement (« Samsung A15 de Yao »)
  registeredAt DateTime  @default(now())
  revokedAt    DateTime? // NULL = actif
  lastSyncAt   DateTime? // mis à jour à chaque /v1/sync/*
  clockSkewMs  Int? // décalage horloge téléphone vs serveur (§8.6)

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens MobileToken[]

  @@index([userId])
  @@index([revokedAt])
}

// PIN mobile haché en Argon2id (le web garde scrypt — §8.7 : coexistence sur
// des tables distinctes). Au PREMIER login mobile, le PIN vérifié contre le
// scrypt du web crée la credential Argon2id (migration transparente).
model MobileCredential {
  id             String    @id @default(cuid())
  userId         String    @unique
  pinHash        String // format : argon2id$t=..,m=..,p=..$salt$hash
  failedAttempts Int       @default(0)
  lockedUntil    DateTime? // verrou 15 min après 5 essais erronés
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Jetons de renouvellement opaques (rotation 30 jours, liés à l'appareil).
// Stockés hachés (sha256). À chaque rotation l'ancienne ligne est SUPPRIMÉE et
// remplacée ; un rejeu dans les 60 secondes qui suivent renvoie le même jeton
// (tolérance de réseau), au-delà il est simplement refusé — jamais de
// verrouillage d'un utilisateur légitime pour une réponse perdue.
model MobileToken {
  id        String   @id @default(cuid())
  deviceId  String
  tokenHash String   @unique // sha256 hex du refresh opaque
  expiresAt DateTime // 30 jours glissants, repoussé à chaque rotation
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

// Code unique par SMS : enregistrement d'appareil (tous les rôles) et second
// facteur à CHAQUE connexion des dirigeants et gérants (§8.7). 6 chiffres,
// 5 minutes de validité, 5 essais, plafonné à 3 envois / heure / numéro.
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String // sha256 hex
  purpose    String // 'device_registration' | 'device_login_2fa'
  deviceId   String? // appareil concerné quand il est déjà connu (2FA)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

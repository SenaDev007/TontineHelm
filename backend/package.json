{
  "name": "tontihelm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TontiHelm — API de gestion de tontines journalières (Express + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "bootstrap:admin": "bun src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.11.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "bun-types": "^1.3.4"
  }
}

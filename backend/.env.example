# ── TontiHelm Backend — variables d'environnement ──

# Base PostgreSQL (Neon). Endpoint pooler recommandé avec Prisma.
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxxx-pooler.region.aws.neon.tech/TontineHelm?sslmode=require"

# Origines autorisées pour le frontend (CORS), séparées par des virgules.
# En production : l'URL Vercel du frontend. « * » autorise tout le monde (dev).
CORS_ORIGINS="*"

# Port d'écoute (Railway fournit PORT automatiquement ; 3001 par défaut en dev).
# PORT=3001

# Compte administrateur plateforme (amorce : bun run bootstrap:admin).
ADMIN_PHONE="+22990000001"
ADMIN_PIN="123456"
